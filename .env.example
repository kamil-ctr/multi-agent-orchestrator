# Copy this file to .env and fill in the keys for whichever agents you want
# enabled. Any agent whose key is missing is skipped automatically — the
# system runs fine with just one key set (e.g. only GEMINI_API_KEY).

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Cohere — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Mistral AI — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# --- Deployment (optional, local dev works without these) ---

# Comma-separated list of origins allowed to call the API (CORS).
# Defaults to http://localhost:5173 (the Vite dev server) if unset.
CORS_ORIGINS=http://localhost:5173

# Base directory for SQLite files (cache.sqlite, history.sqlite).
# Defaults to backend/data if unset. Point this at a persistent disk
# path in production, or /tmp on free tiers with no persistent disk
# (data won't survive a restart/redeploy there).
DATA_DIR=

# Token-by-token streaming for all 4 agents (agent_token SSE events).
# Defaults to true. Set to false to fall back to whole-response dispatch
# (each agent's full text arrives in one agent_done event instead).
STREAMING_ENABLED=true

# Multi-turn conversation context passed to agents on follow-up messages.
# CONVERSATION_CONTEXT_MESSAGES caps how many prior messages are considered;
# CONVERSATION_CONTEXT_MAX_TOKENS trims the oldest of those (heuristic
# chars/4 estimate) until the formatted context fits the budget.
CONVERSATION_CONTEXT_MESSAGES=10
CONVERSATION_CONTEXT_MAX_TOKENS=3000
